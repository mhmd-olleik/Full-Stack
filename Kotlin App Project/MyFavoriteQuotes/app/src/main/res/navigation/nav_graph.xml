<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/quotesListFragment">

    <fragment
        android:id="@+id/quotesListFragment"
        android:name="com.example.myfavoritequotes.ui.quotes.QuotesListFragment"
        android:label="My Quotes"
        tools:layout="@layout/fragment_quotes_list" />

    <fragment
        android:id="@+id/addQuoteFragment"
        android:name="com.example.myfavoritequotes.ui.addquote.AddQuoteFragment"
        android:label="Add Quote"
        tools:layout="@layout/fragment_add_quote" />

    <fragment
        android:id="@+id/apiQuoteFragment"
        android:name="com.example.myfavoritequotes.ui.apiquote.ApiQuoteFragment"
        android:label="Random Quote"
        tools:layout="@layout/fragment_api_quote" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.myfavoritequotes.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
